<RestServiceDefinition>
	<Url>https://login.microsoftonline.com/$$settings_Attribute4$$/oauth2/token</Url>
	<Method>POST</Method>
	<ContentType>application/x-www-form-urlencoded</ContentType>
	<SuccessCode>200</SuccessCode>
	<SecurityProtocol>Tls12</SecurityProtocol>
	<ResultField>access_token</ResultField>
	<FormFields>
		<FormField>
			<Key>client_id</Key>
			<Value>$$settings_Attribute1$$</Value>
		</FormField>
		<FormField>
			<Key>client_secret</Key>
			<Value>$$settings_Attribute3$$</Value>
		</FormField>
		<FormField>
			<Key>resource</Key>
			<Value>$$settings_SapHostName$$</Value>
		</FormField>
		<FormField>
			<Key>grant_type</Key>
			<Value>client_credentials</Value>
		</FormField>
	</FormFields>
</RestServiceDefinition>
