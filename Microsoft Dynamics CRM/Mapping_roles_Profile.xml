<?xml version="1.0" encoding="DOS-862"?>
<ArrayOfCsvFileDescription 
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
    xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <!-- ASSUMPTION: All Business Unit (BU) Names and Field Security Profile (FSP) Names are considered Unique within that D365 CRM instance. -->
    <!-- It is in accordance with the recommended practice to avoid duplicate names for Business units and FSPs -->
	<CsvFileDescription>
        <EntityName>Roles</EntityName>
        <FileName>profiles.xml</FileName>
        <Columns>
            <CsvColumnAttribute>
                <Name>name</Name>
                <MappedColumn>RoleName</MappedColumn>
            </CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>fieldsecurityprofileid</Name>
                <MappedColumn>RoleId</MappedColumn>
            </CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>name</Name>
                <MappedColumn>Description</MappedColumn>
            </CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>@FieldSecurityProfile</Name>
                <MappedColumn>CustomRoleType</MappedColumn>
            </CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>modifiedon</Name>
                <MappedColumn>ChangeDate</MappedColumn>
                <OutputFormat>yyyy-MM-dd'T'HH:mm:ss'Z'</OutputFormat>
            </CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>createdon</Name>
                <MappedColumn>CreateDate</MappedColumn>
                <OutputFormat>yyyy-MM-dd'T'HH:mm:ss'Z'</OutputFormat>
            </CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>modifiedby_internalemailaddress</Name>
                <MappedColumn>ChangeBy</MappedColumn>
            </CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>createdby_internalemailaddress</Name>
                <MappedColumn>CreateBy</MappedColumn>
            </CsvColumnAttribute>
             <CsvColumnAttribute>
                <Name>solution_role_uniquename</Name>
                <MappedColumn>RoleAttribute1</MappedColumn>
            </CsvColumnAttribute>
		</Columns>
    </CsvFileDescription>
    <CsvFileDescription>
        <EntityName>RolesTransactions</EntityName>
        <FileName>roletransactions/ProfileFieldPermissions.xml</FileName>
        <Columns>
            <CsvColumnAttribute>
                <Name>RoleName</Name>
                <MappedColumn>RoleName</MappedColumn>
            </CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>Auth</Name>
                <MappedColumn>AuthIdentifier</MappedColumn>
            </CsvColumnAttribute>
			<CsvColumnAttribute>
                <Name>Object</Name>
                <MappedColumn>Object</MappedColumn>
            </CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>Field</Name>
                <MappedColumn>Field</MappedColumn>
            </CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>Value</Name>
                <MappedColumn>Value</MappedColumn>
            </CsvColumnAttribute>
			</Columns>
    </CsvFileDescription>
	<CsvFileDescription>
        <EntityName>UserRoles</EntityName>
        <FileName>userprofiles.xml</FileName>
        <Columns>
            <CsvColumnAttribute>
                <Name>=if(=isEmpty($$domainname$$),$$systemuserid$$,$$domainname$$)</Name>
                <MappedColumn>UserName</MappedColumn>
            </CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>systemuserprofiles_association_name</Name>
                <MappedColumn>RoleName</MappedColumn>
            </CsvColumnAttribute>
        </Columns>
    </CsvFileDescription>
	  <CsvFileDescription>
        <EntityName>AttachRole</EntityName>
        <FileName>prov/GetProfileId.xml,prov/GetUserId.xml,prov/AttachProfile.xml</FileName>
        <Columns />
    </CsvFileDescription>
	 <CsvFileDescription>
        <EntityName>RemoveRole</EntityName>
        <FileName>prov/GetProfileId.xml,prov/GetUserId.xml,prov/RemoveProfile.xml</FileName>
        <Columns />
	 </CsvFileDescription>

    <CsvFileDescription>
        <EntityName>UserRolesForSingleUser</EntityName>
        <FileName>EchoProfileTable.xml,SingleUserProfiles.xml</FileName>
        <Columns>
          <CsvColumnAttribute>
                <Name>=if(=isEmpty($$domainname$$),$$systemuserid$$,$$domainname$$)</Name>
                <MappedColumn>UserName</MappedColumn>
            </CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>systemuserprofiles_association_name</Name>
                <MappedColumn>RoleName</MappedColumn>
            </CsvColumnAttribute>
        </Columns>
     </CsvFileDescription>
</ArrayOfCsvFileDescription>