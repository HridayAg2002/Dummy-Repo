<?xml version="1.0" encoding="DOS-862"?>
<ArrayOfCsvFileDescription >
    <!-- ASSUMPTION: All Business Unit (BU) Names and Field Security Profile (FSP) Names are considered Unique within that D365 CRM instance. -->
    <!-- It is in accordance with the recommended practice to avoid duplicate names for Business units and FSPs -->
    <CsvFileDescription>
        <EntityName>SingleUser</EntityName>
        <FileName>singleuser.xml,fetchLogonSingleUser.xml</FileName>
        <Columns>
            <CsvColumnAttribute>
                <Name>systemuserid</Name>
                <MappedColumn>ApiIdentifier</MappedColumn>
            </CsvColumnAttribute>
            <CsvColumnAttribute>
            <Name>=if(=isEmpty($$domainname$$),$$internalemailaddress$$,$$domainname$$)</Name>
                <MappedColumn>UserName</MappedColumn>
            </CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>internalemailaddress</Name>
                <MappedColumn>EMail</MappedColumn>
            </CsvColumnAttribute>
			 <CsvColumnAttribute>
                <Name>fullname</Name>
                <MappedColumn>FullName</MappedColumn>
            </CsvColumnAttribute>
			<CsvColumnAttribute>
				<Name>=if(=equal($$isdisabled$$,1),64,0)</Name>
                <MappedColumn>LockStatus</MappedColumn>
            </CsvColumnAttribute>
            <!-- User's Business Unit is mapped to Department -->
            <CsvColumnAttribute>
                <Name>businessunitid_name</Name>
                <MappedColumn>Department</MappedColumn>
       		</CsvColumnAttribute>
            <!-- Business Unit ID is mapped to Building -->
			<CsvColumnAttribute>
                <Name>businessunitid_businessunitid</Name>
                <MappedColumn>Building</MappedColumn>
       		</CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>createdon</Name>
                <MappedColumn>CreateDate</MappedColumn>
                <OutputFormat>yyyy-MM-dd HH:mm:ss</OutputFormat>
       		</CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>modifiedon</Name>
                <MappedColumn>LastChange</MappedColumn>
                <OutputFormat>yyyy-MM-dd HH:mm:ss</OutputFormat>
       		</CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>lastlogon</Name>
                <MappedColumn>LastLogon</MappedColumn>
                <OutputFormat>yyyy-MM-dd HH:mm:ss</OutputFormat>
       		</CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>address1_country</Name>
                <MappedColumn>Country</MappedColumn>
       		</CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>address1_city</Name>
                <MappedColumn>City</MappedColumn>
       		</CsvColumnAttribute>
        </Columns>
    </CsvFileDescription>

    <CsvFileDescription>
        <EntityName>Users</EntityName>
        <FileName>users.xml,fetchLogon.xml</FileName>
        <Columns>
            <CsvColumnAttribute>
                <Name>systemuserid</Name>
                <MappedColumn>ApiIdentifier</MappedColumn>
            </CsvColumnAttribute>
            <CsvColumnAttribute>
            <Name>=if(=IsEmpty($$domainname$$),$$systemuserid$$,$$domainname$$)</Name>
