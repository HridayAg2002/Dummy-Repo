            </CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>internalemailaddress</Name>
                <MappedColumn>EMail</MappedColumn>
            </CsvColumnAttribute>
			 <CsvColumnAttribute>
                <Name>fullname</Name>
                <MappedColumn>FullName</MappedColumn>
            </CsvColumnAttribute>
			<CsvColumnAttribute>
				<Name>=if(=equal($$isdisabled$$,1),64,0)</Name>
                <MappedColumn>LockStatus</MappedColumn>
            </CsvColumnAttribute>
            <!-- User's Business Unit is mapped to Department -->
            <CsvColumnAttribute>
                <Name>businessunitid_name</Name>
                <MappedColumn>Department</MappedColumn>
       		</CsvColumnAttribute>
            <!-- Business Unit ID is mapped to Building -->
			<CsvColumnAttribute>
                <Name>businessunitid_businessunitid</Name>
                <MappedColumn>Building</MappedColumn>
       		</CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>createdon</Name>
                <MappedColumn>CreateDate</MappedColumn>
                <OutputFormat>yyyy-MM-dd HH:mm:ss</OutputFormat>
       		</CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>modifiedon</Name>
                <MappedColumn>LastChange</MappedColumn>
                <OutputFormat>yyyy-MM-dd HH:mm:ss</OutputFormat>
       		</CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>lastlogon</Name>
                <MappedColumn>LastLogon</MappedColumn>
                <OutputFormat>yyyy-MM-dd HH:mm:ss</OutputFormat>
       		</CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>address1_country</Name>
                <MappedColumn>Country</MappedColumn>
       		</CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>address1_city</Name>
                <MappedColumn>City</MappedColumn>
       		</CsvColumnAttribute>
        </Columns>
    </CsvFileDescription>
    
    <CsvFileDescription>
        <Operation>SetUserPassword</Operation>
        <FileName>AuthenticationFlow_azure.xml,prov/SetUserPassword.xml</FileName>
    </CsvFileDescription>

	<CsvFileDescription>
        <EntityName>Roles</EntityName>
        <FileName>roles.xml</FileName>
        <Columns>
