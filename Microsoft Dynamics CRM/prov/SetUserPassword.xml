<RestServiceDefinition>
    <Url><![CDATA[https://graph.microsoft.com/$$api_version$$/users/$$encoded_username$$]]></Url>
    <Method>PATCH</Method>
    <ContentType>application/json</ContentType>
    <SecurityProtocol>Tls12</SecurityProtocol>
    <UseResults>First</UseResults>
    <DataTemplate>
		$$ParametersForJson$$
	</DataTemplate>
    <Headers>
      <Header>
        <Name>Authorization</Name>
        <Value>Bearer $$access_token_azur$$</Value>
      </Header>
    </Headers>
    <Parameters>
        <ParameterInfo>
            <Key>passwordProfile.forceChangePasswordNextSignIn</Key>
            <Name>ForceChangePasswordNextSignIn</Name>
            <DisplayName>ForceChangePasswordNextSignIn</DisplayName>
            <Default>true</Default>
            <DataType>Boolean</DataType>
        </ParameterInfo>
        <ParameterInfo>
            <Key>passwordProfile.password</Key>
            <Name>Password</Name>
            <DisplayName>Password</DisplayName>
            <Template>$$password$$</Template>
        </ParameterInfo>
    </Parameters>
    	<Variables>
        <Variable>
            <Name>encoded_username</Name>
            <Value>=escape($$username$$)</Value>
        </Variable>
    </Variables>
    <SuccessCode>200,204</SuccessCode>
    <FailureIndicators>
		<FailureIndicator>
			<Key>message</Key>
			<Value>does not exist or one of its queried reference-property objects are not present</Value>
			<Result>A parameter was provided that does not exist in the user object in MS Entra ID.</Result>
		</FailureIndicator>
        <FailureIndicator>
			<Key>message</Key>
			<Value>The specified password does not comply with password complexity requirements. </Value>
			<Result>The specified password does not comply with password complexity requirements. </Result>
		</FailureIndicator>
        
	</FailureIndicators>  
</RestServiceDefinition>