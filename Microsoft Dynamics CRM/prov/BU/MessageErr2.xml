<RestServiceDefinition>
    <Url>ECHO</Url>
    <Method>POST</Method>
    <ContentType>application/json</ContentType>
    <DataTemplate>{
        "message":"Failure",
    }</DataTemplate>
    <FailureIndicators>
        <FailureIndicator>
            <Key>message</Key>
            <Value>Failure</Value>
            <Result>BusinessUnit does not exist Error</Result>
        </FailureIndicator>
    </FailureIndicators>         
    <PreRunCondition>=equal($$BUcnt$$,0)</PreRunCondition>
</RestServiceDefinition>