<RestServiceDefinition>
  <Url><![CDATA[/api/data/v9.1/systemusers?$top=1&$expand=businessunitid($select=name),
    defaultmailbox($select=emailaddress)&$select=firstname,lastname,fullname,domainname
    ,employeeid,address1_telephone1,address1_city,address1_country,jobtitle,createdon,modifiedon
    ,systemuserid,nickname,isdisabled,internalemailaddress,systemuserid]]></Url>
	<Method>GET</Method>
	<ContentType>application/json</ContentType>
  	<ResultField>value</ResultField>
	<SuccessCode>200,204</SuccessCode>
 <SqlTable>usertbl</SqlTable>
    <SqlExecute>
<![CDATA[    
        SELECT
            CASE
                WHEN (SELECT COUNT(*) FROM usertbl) > 0
                THEN 'Successfully able to read users'
                ELSE 'Fail to read users'
            END AS message,
            CASE
                WHEN (SELECT COUNT(*) FROM usertbl) > 0
                THEN 1
                ELSE 0
            END AS success
    ]]>
    </SqlExecute>
</RestServiceDefinition>