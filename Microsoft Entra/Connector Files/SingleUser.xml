<RestServiceDefinition>
    <Url><![CDATA[https://graph.microsoft.com/$$api_version$$/users?$filter=userPrincipalName eq '$$modified_username$$'&$select=id,displayName,userPrincipalName,accountEnabled,mail,createdDateTime,lastPasswordChangeDateTime,EmployeeType,Department,CompanyName,City,Country,userType]]></Url>
    <Method>GET</Method>
    <ContentType>text/plain</ContentType>
    <SuccessCode>200</SuccessCode>
    <SecurityProtocol>Tls12</SecurityProtocol>
    <ResultField>value</ResultField>
    <PaginationConfiguration>
		<ShouldDisablePagination>true</ShouldDisablePagination>
	</PaginationConfiguration>
	<Variables>
        <Variable>
            <Name>modified_username</Name>
            <Value>=escape(=replace($$Username$$,',''))</Value>
        </Variable>
    </Variables>
</RestServiceDefinition>