<RestServiceDefinition>
    <Url><![CDATA[https://graph.microsoft.com/$$api_version$$/$$ig_path$$]]></Url>
   <UseResults>First</UseResults>
    <Method>POST</Method>
   
    <ContentType>application/json</ContentType>
   
    <SecurityProtocol>Tls12</SecurityProtocol>
    <DataTemplate>		<![CDATA[
    {
  "source": "Pathlock.SodCheckProcess",
  "type": "microsoft.graph.accessPackageCustomExtensionStage.assignmentRequestGranted",
  "data": {
    "@odata.type": "microsoft.graph.accessPackageAssignmentRequestCallbackData",
    "stage": "$$Event$$",
    "customExtensionStageInstanceId": "$$ig_InstanceId$$",
    "customExtensionStageInstanceDetail": "Access Assigned by Pathlock"
  }
}
      
      ]]>
    </DataTemplate>
    <SuccessCode>200,201,202</SuccessCode>
    <Parameters>
	   <ParameterInfo>
			<Key>ig_path</Key>
			<Name>ig_path</Name>
			<DisplayName>ig_path</DisplayName>
			<DataType>String</DataType>
		</ParameterInfo>
		<ParameterInfo>
			<Key>ig_InstanceId</Key>
			<Name>ig_InstanceId</Name>
			<DisplayName>ig_InstanceId</DisplayName>
			<DataType>String</DataType>
		</ParameterInfo>
	
	</Parameters>
    
</RestServiceDefinition>