<RestServiceDefinition>
    <Url><![CDATA[https://graph.microsoft.com/beta/identityGovernance/entitlementManagement/accessPackageAssignmentPolicies]]></Url>
    
    <Method>POST</Method>
    <UseResults>First</UseResults>
    <ContentType>application/json</ContentType>
    <ResultField>value</ResultField>
    <SecurityProtocol>Tls12</SecurityProtocol>
    <DataTemplate>		<![CDATA[
      {
        "displayName": "extension-policy-by-pathlock",
        "description": "policy-by-pathlock",
        "accessPackageId": "$$accessPackageId$$",
        "requestApprovalSettings": null,
        "requestorSettings": {
          "acceptRequests": true,
          "scopeType": "AllExistingDirectorySubjects",
          "allowedRequestors": [],
          "isOnBehalfAllowed": false
        },
        "accessReviewSettings": null,
        "questions": [],
        "customExtensionHandlers": [
          {
            "stage": "assignmentRequestGranted",
            "customExtension": {
              "id": "$$customExtensionId$$"
            }
          },
          {
            "stage": "assignmentRequestRemoved",
            "customExtension": {
              "id": "$$customExtensionId$$"
            }
          }
        ]
      }
      
      ]]>
    </DataTemplate>
    <SuccessCode>200,201</SuccessCode>
    <SqlTable>accessPackageAssignmentPolicy</SqlTable>
    <RetriesMechanismConfiguration>
      <HttpStatusCode>$$retries_statuses$$</HttpStatusCode>
      <Attempts>$$retries_attempts$$</Attempts>
      <WaitingInSeconds>$$retries_waitseconds$$</WaitingInSeconds>
    </RetriesMechanismConfiguration>
</RestServiceDefinition>