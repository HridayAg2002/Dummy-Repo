<RestServiceDefinition>
    <Url><![CDATA[https://graph.microsoft.com//beta/identityGovernance/entitlementManagement/assignmentRequests/$$requestid$$]]></Url>
    <Method>GET</Method>
    <ContentType>application/json</ContentType>
    <SecurityProtocol>Tls12</SecurityProtocol>
    <ResultField>value</ResultField>
    <Parameters>
        <ParameterInfo>
            <Name>requestid</Name>
            <DisplayName>requestid</DisplayName> 
        </ParameterInfo>
       
    </Parameters>
    <SuccessCode>200</SuccessCode>
    <SqlTable>requestInfo</SqlTable>
   <CollectionsToExtract>history</CollectionsToExtract>
   <SqlExecute>
       SELECT 
        history_userDisplayName ApproverName,
        history_userPrincipalName Approver,
        history_actionDateTime ApprovalTimestamp,
        history_detail ApproverComment,
        justification RequestorJustification
    FROM 
        requestInfo where history_action = 'Approved';

   </SqlExecute>
</RestServiceDefinition>