<RestServiceDefinition>
    <Url><![CDATA[https://graph.microsoft.com/$$api_version$$/Applications/$$application_id$$?$select=id,displayName,appRoles]]></Url>
    <Method>GET</Method>
    <ContentType>application/json</ContentType>
    <ResultField>value</ResultField>
    <SecurityProtocol>Tls12</SecurityProtocol>
    <UseResults>All</UseResults>
    <SuccessCode>200</SuccessCode>
    <SqlTable>existingAppRoles</SqlTable>
    
    <CollectionsToExtract>appRoles</CollectionsToExtract>
    <SqlExecute>
     --identify roles that are in businessroles, but not in existingApproles, if any, we should wait longer
     --select count(*) from existingAppRoles where approles_description
    </SqlExecute>
    <PaginationConfiguration>
		<PollingConfig>
			<Count>5</Count>
			<IntervalSeconds>1</IntervalSeconds>
    		<CompletionConditions>
    			<PollingConfigCondition>
    				<Tag>status</Tag>
    				<Value>completed</Value>
    				<ShouldMatch>true</ShouldMatch>
    			</PollingConfigCondition>
    		</CompletionConditions>
    		<AbortConditions>
    			<PollingConfigCondition>
    				<Tag>status</Tag>
    				<Value>pending</Value>
    				<ShouldMatch>true</ShouldMatch>			
    		    </PollingConfigCondition>
    		</AbortConditions>
		</PollingConfig>
	</PaginationConfiguration>
</RestServiceDefinition>