<RestServiceDefinition>
	<Url>https://graph.microsoft.com/v1.0/identityGovernance/entitlementManagement/accessPackages/$$PackageId$$/resourceRoleScopes</Url>
	<Method>POST</Method>
	<ContentType>application/json</ContentType>
    <UseResults>All</UseResults>
	<DataTemplate>
		<![CDATA[
            $$role_json_output$$
        ]]>
	</DataTemplate>
    <RetriesMechanismConfiguration>
		<HttpStatusCode>$$retries_status_18$$</HttpStatusCode>
		<Attempts>$$retries_attempts$$</Attempts>
		<WaitingInSeconds>$$retries_waitseconds$$</WaitingInSeconds>
	</RetriesMechanismConfiguration>
</RestServiceDefinition>