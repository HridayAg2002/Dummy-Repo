<RestServiceDefinition>
    <Url><![CDATA[https://graph.microsoft.com/v1.0/identityGovernance/entitlementManagement/catalogs/$$CatalogId$$/?$expand=resources]]></Url>
    <Method>GET</Method>
    <ContentType>application/json</ContentType>
    <ResultField>value</ResultField>
    <SecurityProtocol>Tls12</SecurityProtocol>
    <UseResults>First</UseResults>
    <SuccessCode>200</SuccessCode>
    <SqlTable>accessPackageResources</SqlTable>
    <CollectionsToExtract>resources</CollectionsToExtract>
   <SqlExecute>
    --select the resources that are relevant for the Business Role
    SELECT 
    id as CatalogId,
       resources_id,
       resources_displayName,
      resources_originSystem,
       resources_originId
  FROM accessPackageResources
  where resources_originSystem = 'AadApplication' and resources_originId in (select id from servicePrincipals)


   </SqlExecute>
   <RetriesMechanismConfiguration>
    <HttpStatusCode>$$retries_statuses$$</HttpStatusCode>
    <Attempts>$$retries_attempts$$</Attempts>
    <WaitingInSeconds>$$retries_waitseconds$$</WaitingInSeconds>
</RetriesMechanismConfiguration>
</RestServiceDefinition>