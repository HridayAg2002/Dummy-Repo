<RestServiceDefinition>
    <Url><![CDATA[https://graph.microsoft.com/$$api_version$$/identityGovernance/entitlementManagement/catalogs?$filter=displayName eq '$$PackageCatalog$$'&$select=id]]></Url>
    <Method>GET</Method>
    <ContentType>application/json</ContentType>
    <SecurityProtocol>Tls12</SecurityProtocol>
    <ResultField>value</ResultField>
    <Parameters>
        <ParameterInfo>
            <Name>PackageName</Name>
            <DisplayName>PackageName</DisplayName> 
        </ParameterInfo>
        <ParameterInfo>
            <Name>PackageDescription</Name>
            <DisplayName>PackageDescription</DisplayName> 
        </ParameterInfo>
        <ParameterInfo>
            <Name>PackageCatalog</Name>
            <DisplayName>PackageCatalog</DisplayName> 
        </ParameterInfo>
    </Parameters>
    <SuccessCode>200</SuccessCode>
    <SqlTable>catalog</SqlTable>
    <SqlExecuteRequiredColumns>catalog.id</SqlExecuteRequiredColumns>
    <SqlExecute>select id as CatalogId from catalog</SqlExecute>
    <RetriesMechanismConfiguration>
		<HttpStatusCode>$$retries_statuses$$</HttpStatusCode>
		<Attempts>$$retries_attempts$$</Attempts>
		<WaitingInSeconds>$$retries_waitseconds$$</WaitingInSeconds>
	</RetriesMechanismConfiguration>
</RestServiceDefinition>