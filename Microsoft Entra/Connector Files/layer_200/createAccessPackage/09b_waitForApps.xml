<RestServiceDefinition>
    <Url>ECHO</Url>
    <UseResults>First</UseResults>
    <DisableAuthenticationFlow>true</DisableAuthenticationFlow>
    <ContentType>application/json</ContentType>
    <DataTemplate>{"message":"On-hold"}</DataTemplate>
    <PaginationConfiguration>
        <PollingConfig>
            <Count>2</Count>
            <IntervalSeconds>2</IntervalSeconds>
            <CompletionConditions>
                <PollingConfigCondition>
                    <Tag>Message</Tag>
                    <Value>Dummy</Value>
                    <ShouldMatch>true</ShouldMatch>
                </PollingConfigCondition>
            </CompletionConditions>
        </PollingConfig>
    </PaginationConfiguration>
    <SqlExecute>select distinct systems.id as application_id from systems</SqlExecute>
</RestServiceDefinition>
