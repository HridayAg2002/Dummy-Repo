<RestServiceDefinition>
	<Url>https://graph.microsoft.com/$$api_version$$/identityGovernance/entitlementManagement/resourceRequests</Url>
	<Method>POST</Method>
	<ContentType>application/json</ContentType>
  <UseResults>All</UseResults>
	<DataTemplate>
		<![CDATA[
   {
  "requestType": "adminAdd",
  "resource": {
    
    "originId": "$$servicePrincipalId$$",
    "originSystem": "AadApplication"
  },
  "catalog": {
    "id": "$$catalogId$$"
  }
}
]]>
	</DataTemplate>
  <RetriesMechanismConfiguration>
		<HttpStatusCode>$$retries_status_18$$</HttpStatusCode>
		<Attempts>$$retries_attempts$$</Attempts>
		<WaitingInSeconds>$$retries_waitseconds_18$$</WaitingInSeconds>
	</RetriesMechanismConfiguration>
</RestServiceDefinition>