<RestServiceDefinition xmlns="http://schemas.datacontract.org/2004/07/Xpandion.ProfileTailor.LINQtoCSV"
    xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
    <Url><![CDATA[https://login.microsoftonline.com/$$tenantID$$/oauth2/v2.0/token]]></Url>
    <Method>POST</Method>
    <DisableAuthenticationFlow>true</DisableAuthenticationFlow>
    <ContentType>application/x-www-form-urlencoded</ContentType>
    <SuccessCode>200</SuccessCode>
    <SecurityProtocol>Tls12</SecurityProtocol>
    
    <SqlTable>access</SqlTable>
    <SqlExecute>
    SELECT
            CASE
                WHEN (SELECT COUNT(*) FROM sqlite_master WHERE type='table' AND name IN ('access')) = 1
                THEN 'Successfully able to verify credentials'
                ELSE 'Fail to verify credentials'
            END AS message,
            CASE
                WHEN (SELECT COUNT(*) FROM sqlite_master WHERE type='table' AND name IN ('access')) = 1
                THEN 1
                ELSE 0
            END AS success
    </SqlExecute>
     
    <UseBasicAuthntication>true</UseBasicAuthntication>
    <FormFields>
        <FormField>
            <Key>grant_type</Key>
            <Value>client_credentials</Value>
        </FormField>
        <FormField>
            <Key>scope</Key>
            <Value>https://graph.microsoft.com/.default</Value>
        </FormField>
    </FormFields>
</RestServiceDefinition>