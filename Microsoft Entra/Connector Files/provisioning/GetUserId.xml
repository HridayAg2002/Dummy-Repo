<RestServiceDefinition>
    <Url><![CDATA[https://graph.microsoft.com/$$api_version$$/users?$filter=userPrincipalName eq '$$encoded_username$$'&$select=id]]></Url>
    <Method>GET</Method>
    <ContentType>text/plain</ContentType>
    <SuccessCode>200</SuccessCode>
    <SecurityProtocol>Tls12</SecurityProtocol>
    <ResultField>value</ResultField>
    <PaginationConfiguration>
		<ShouldDisablePagination>true</ShouldDisablePagination>
	</PaginationConfiguration>
	<SqlTable>user</SqlTable>
	 <Parameters>
         <ParameterInfo> 
            <Key>username</Key>
            <Name>username</Name>
            <DisplayName>username</DisplayName>
            <Default></Default>
        </ParameterInfo>
        <ParameterInfo> 
            <Key>rolename</Key>
            <Name>rolename</Name>
            <DisplayName>rolename</DisplayName>
            <Default></Default>
        </ParameterInfo>
      
     </Parameters>
     	<Variables>
        <Variable>
            <Name>encoded_username</Name>
            <Value>=escape(=replace($$username$$,',''))</Value>
        </Variable>
    </Variables>
</RestServiceDefinition>