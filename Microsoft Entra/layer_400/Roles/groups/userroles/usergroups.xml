<RestServiceDefinition>
  <Url><![CDATA[https://graph.microsoft.com/$$api_version$$/groups/$$groupId$$/members/microsoft.graph.user?$count=true&$select=userPrincipalName&$top=999]]></Url>
    <PreRunCondition>=Not(=equal(=upper($$ConsistencyLevel$$),EVENTUAL))</PreRunCondition>
  <Method>GET</Method>
  <ContentType>application/json</ContentType>
  <SuccessCode>200</SuccessCode>
  <SecurityProtocol>Tls12</SecurityProtocol>
  <UseResults>All</UseResults>
  <DataTemplateExtraData>
    <ExtraData>
      <Key>RoleName</Key>
      <Value>$$RoleName$$</Value>
    </ExtraData>
  </DataTemplateExtraData>
  <PaginationConfiguration>
    <NextPagePaginationConfig>
      <NextUrlTag>
        ['odata.nextLink']
      </NextUrlTag>
    </NextPagePaginationConfig>
  </PaginationConfiguration>
  <CollectionsToExtract>value</CollectionsToExtract>
  <SqlTable>userroles</SqlTable>
  <SqlExecute>select RoleName, value_userPrincipalName as UserName from userroles where username is not null</SqlExecute>
</RestServiceDefinition>