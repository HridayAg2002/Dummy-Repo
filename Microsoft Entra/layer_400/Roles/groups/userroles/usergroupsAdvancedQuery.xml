<RestServiceDefinition>
  <Url><![CDATA[https://graph.microsoft.com/$$api_version$$/groups/$$groupId$$/members/microsoft.graph.user?$count=true&$select=userPrincipalName&$top=999&$filter=$$user_filter$$]]></Url>
    <PreRunCondition>=equal(=upper($$ConsistencyLevel$$),EVENTUAL)</PreRunCondition>
  <Method>GET</Method>
  <Headers>
		<Header>
			<Name>ConsistencyLevel</Name>
			<Value>eventual</Value>
		</Header>
	</Headers>
  <ContentType>application/json</ContentType>
  <TokenRegenerationCount>2</TokenRegenerationCount>
  <SuccessCode>200</SuccessCode>
  <SecurityProtocol>Tls12</SecurityProtocol>
  <UseResults>All</UseResults>
  <DataTemplateExtraData>
    <ExtraData>
      <Key>RoleName</Key>
      <Value>$$RoleName$$</Value>
    </ExtraData>
  </DataTemplateExtraData>
  <PaginationConfiguration>
    <NextPagePaginationConfig>
      <NextUrlTag>
        ['odata.nextLink']
      </NextUrlTag>
    </NextPagePaginationConfig>
  </PaginationConfiguration>
  <CollectionsToExtract>value</CollectionsToExtract>
  <SqlTable>userroles</SqlTable>
  <SqlExecute>select RoleName, value_userPrincipalName as UserName from userroles where username is not null</SqlExecute>
</RestServiceDefinition>