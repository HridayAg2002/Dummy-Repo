<?xml version="1.0" encoding="DOS-862"?>
<ArrayOfCsvFileDescription>
    <!-- Entra ID Users List -->
    <CsvFileDescription>
        <Operation>Users</Operation>
        <FileName>Users.xml,UsersAdvancedQuery.xml</FileName>
        <Columns>
            <CsvColumnAttribute>
                <Name>userPrincipalName</Name>
                <MappedColumn>UserName</MappedColumn>
            </CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>displayName</Name>
                <MappedColumn>FullName</MappedColumn>
            </CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>mail</Name>
                <MappedColumn>EMail</MappedColumn>
            </CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>createdDateTime</Name>
                <OutputFormat>yyyy-MM-ddTHH:mm:ssZ</OutputFormat>
                <MappedColumn>CreateDate</MappedColumn>
            </CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>lastPasswordChangeDateTime</Name>
                <OutputFormat>yyyy-MM-ddTHH:mm:ssZ</OutputFormat>
                <MappedColumn>PasswordChangedDate</MappedColumn>
            </CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>=if(=equal($$accountEnabled$$,True),0,64)</Name>
                <MappedColumn>LockStatus</MappedColumn>
            </CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>id</Name>
                <MappedColumn>ApiIdentifier</MappedColumn>
            </CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>EmployeeType</Name>
                <MappedColumn>UserType</MappedColumn>
            </CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>CompanyName</Name>
                <MappedColumn>Company</MappedColumn>
            </CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>City</Name>
                <MappedColumn>City</MappedColumn>
            </CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>EmployeeType</Name>
                <MappedColumn>Building</MappedColumn>
            </CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>Country</Name>
                <MappedColumn>Country</MappedColumn>
            </CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>Department</Name>
                <MappedColumn>Department</MappedColumn>
            </CsvColumnAttribute>
        </Columns>
    </CsvFileDescription>
    <!-- Entra Group assignments for all users -->
    <CsvFileDescription>
        <Operation>UserRoles</Operation>
        <FileName>Roles/groups/userroles/groups.xml,
            Roles/groups/userroles/dummytable.xml
            Roles/groups/userroles/usergroups.xml,
            Roles/groups/userroles/usergroupsAdvancedQuery.xml
        </FileName>
        <Columns>
            <CsvColumnAttribute>
                <Name>UserName</Name>
                <MappedColumn>UserName</MappedColumn>
            </CsvColumnAttribute>
            <CsvColumnAttribute>
                <Name>RoleName</Name>
                <MappedColumn>RoleName</MappedColumn>
            </CsvColumnAttribute>
        </Columns>
    </CsvFileDescription>
</ArrayOfCsvFileDescription>
