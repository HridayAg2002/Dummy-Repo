<RestServiceDefinition>
    <Url><![CDATA[https://graph.microsoft.com/$$api_version$$/users?$select=id,displayName,userPrincipalName,accountEnabled,mail,createdDateTime,lastPasswordChangeDateTime,EmployeeType,Department,CompanyName,City,Country&$count=true&$top=999&$filter=$$user_filter$$]]></Url>
    <PreRunCondition>=equal(=upper($$ConsistencyLevel$$),EVENTUAL)</PreRunCondition>
    <Method>GET</Method>
    <ContentType>text/plain</ContentType>
    <SuccessCode>200</SuccessCode>
    <SecurityProtocol>Tls12</SecurityProtocol>
    <ResultField>value</ResultField>
    <Headers>
		<Header>
			<Name>ConsistencyLevel</Name>
			<Value>eventual</Value>
		</Header>
	</Headers>
</RestServiceDefinition>